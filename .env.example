# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docs_rag

# --- Embedding (BGE-M3 via TEI) ---
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
TEI_URL=http://localhost:8080

# --- Generation LLM (Gemini) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=your-key-here

# --- Chunking ---
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# --- Retrieval ---
TOP_K=8
MIN_SCORE=0.2

# --- Storage (M1: local disk) ---
STORAGE_DIR=./storage

# Operational stats at GET /admin/stats (header: X-Admin-Token).
# Leave empty to disable — the route then 404s instead of 401s, so an
# unconfigured deployment does not advertise it.
ADMIN_TOKEN=

# 토큰 비용 알림 (scripts/cost_report.py). 백만 토큰당 단가를 제공자
# 가격표에서 가져와 채운다 — 기본값을 넣지 않는 이유는 틀린 금액이 없는
# 금액보다 나쁘기 때문이다. COST_CEILING 을 넘으면 스크립트가 1로 끝난다.
COST_PER_MTOK_IN=
COST_PER_MTOK_OUT=
COST_CURRENCY=USD
COST_CEILING=

# 세션 쿠키를 HTTPS 로만 보낼지. 기본 true — 잊었을 때 안전한 쪽으로 실패해야
# 한다. 브라우저는 http://localhost 를 신뢰 가능한 출처로 보므로 로컬 개발도
# true 로 동작한다(확인함). 평문 HTTP 로 외부에 노출하는 예외적인 경우에만 false.
SESSION_COOKIE_SECURE=true

# 로그인·가입 시도 제한(분당, IP·이메일 각각). 0 이면 끔.
RATE_LIMIT_AUTH_PER_MIN=10

# --- 이메일 인증 ---
# console 은 링크를 로그로만 찍는다(개발·테스트). resend 로 두더라도
# RESEND_API_KEY 가 비면 console 로 폴백한다.
MAIL_PROVIDER=console
RESEND_API_KEY=
# 도메인이 없으면 Resend 는 이 주소로만 보내고 계정 소유자 본인에게만
# 전달된다. 남이 가입해서 인증까지 마치게 하려면 도메인 + SPF/DKIM 이
# 필요하고, 그때 no-reply@<도메인> 으로 바꾼다.
MAIL_FROM=onboarding@resend.dev
# 인증 링크가 가리키는 곳. 백엔드가 아니라 프론트엔드 오리진이다.
APP_BASE_URL=http://localhost:3000
VERIFY_TOKEN_TTL_HOURS=24
# 미인증 계정의 맛보기 한도. 하루가 아니라 계정 수명 전체 누적이다.
UNVERIFIED_QUOTA_QUERIES=5
UNVERIFIED_QUOTA_DOCUMENTS=1
RATE_LIMIT_VERIFY_RESEND_PER_MIN=1

# Postgres 자격증명. 공개 호스트에 올린다면 비밀번호를 반드시 바꿀 것 —
# compose 기본값은 로컬 편의용이고, 기본 비밀번호는 제일 먼저 시도된다.
# DB 포트는 127.0.0.1 에만 바인딩된다(앱은 compose 네트워크로 닿는다).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=docs_rag
