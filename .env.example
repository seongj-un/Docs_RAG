# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docs_rag

# --- Embedding (BGE-M3 via TEI) ---
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
TEI_URL=http://localhost:8080

# --- Generation LLM (Gemini) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=your-key-here

# --- Chunking ---
CHUNK_SIZE=700
CHUNK_OVERLAP=100
# 청킹 전략 (M7 W5). fixed = 고정 토큰 창(M1 부터의 동작), section = 헤딩 경계.
# 바꾸면 **이미 색인된 문서를 다시 색인해야** 이득이 생긴다 — 설정 한 줄이
# 아니라 재색인 작업이다. 측정치는 app/config.py 의 chunk_strategy 주석에.
CHUNK_STRATEGY=fixed
# 임베딩 입력 앞에 "명세 > 학생 > 목록 조회" 를 붙인다. 저장되는 content 는
# 안 바뀐다(인용 스니펫과 골든셋 스팬 역매칭이 축자 부분문자열에 기대고 있다).
CHUNK_HEADING_PREFIX=false

# --- Retrieval ---
TOP_K=8
MIN_SCORE=0.2
# 리랭커에 넘길 후보 수(검색기 dense/sparse 각각). 리랭킹 시간이 여기에 거의
# 비례한다 — 근거와 값을 고른 이유는 app/config.py의 cand_k 주석 참조.
CAND_K=40

# --- Storage (M1: local disk) ---
STORAGE_DIR=./storage

# 앱 로그 레벨. 기본 WARNING 은 이 앱이 실제로 찍는 것과 맞다 — 로그는
# "삼킨 예외"에만 쓰고 나머지 관측은 Postgres(traces·usage_events)로 간다.
# INFO 로 올리면 요청 단위 소음이 늘 뿐 새 정보는 거의 없다. SQL 은 이
# 값과 무관하게 계속 눌려 있다(바인딩 파라미터에 질문·답변이 실린다 —
# app/logging.py 참조).
LOG_LEVEL=WARNING

# Operational stats at GET /admin/stats (header: X-Admin-Token).
# Leave empty to disable — the route then 404s instead of 401s, so an
# unconfigured deployment does not advertise it.
ADMIN_TOKEN=

# 토큰 비용 알림 (scripts/cost_report.py). 백만 토큰당 단가를 제공자
# 가격표에서 가져와 채운다 — 기본값을 넣지 않는 이유는 틀린 금액이 없는
# 금액보다 나쁘기 때문이다. COST_CEILING 을 넘으면 스크립트가 1로 끝난다.
COST_PER_MTOK_IN=
COST_PER_MTOK_OUT=
COST_CURRENCY=USD
COST_CEILING=

# 세션 쿠키를 HTTPS 로만 보낼지. 기본 true — 잊었을 때 안전한 쪽으로 실패해야
# 한다. 브라우저는 http://localhost 를 신뢰 가능한 출처로 보므로 로컬 개발도
# true 로 동작한다(확인함). 평문 HTTP 로 외부에 노출하는 예외적인 경우에만 false.
SESSION_COOKIE_SECURE=true

# 로그인·가입 시도 제한(분당, IP·이메일 각각). 0 이면 끔.
RATE_LIMIT_AUTH_PER_MIN=10

# --- 이메일 인증 ---
# console 은 링크를 로그로만 찍는다(개발·테스트). resend 로 두더라도
# RESEND_API_KEY 가 비면 console 로 폴백한다.
MAIL_PROVIDER=console
RESEND_API_KEY=
# 도메인이 없으면 Resend 는 이 주소로만 보내고 계정 소유자 본인에게만
# 전달된다. 남이 가입해서 인증까지 마치게 하려면 도메인 + SPF/DKIM 이
# 필요하고, 그때 no-reply@<도메인> 으로 바꾼다.
MAIL_FROM=onboarding@resend.dev
# 인증 링크가 가리키는 곳. 백엔드가 아니라 프론트엔드 오리진이다.
APP_BASE_URL=http://localhost:3000
VERIFY_TOKEN_TTL_HOURS=24
# 미인증 계정의 맛보기 한도. 하루가 아니라 계정 수명 전체 누적이다.
UNVERIFIED_QUOTA_QUERIES=5
UNVERIFIED_QUOTA_DOCUMENTS=1
# 문서 1개로 제한해도 그 한 문서가 500쪽일 수 있다 — 비용은 쪽수에
# 비례하므로 쪽수도 따로 막는다.
UNVERIFIED_QUOTA_PAGES=50
RATE_LIMIT_VERIFY_RESEND_PER_MIN=1

# 쿼터 예약(usage_events, 체크-후-기록 원자화)이 죽은 프로세스 때문에
# 끝내 정산되지 못했을 때 고아로 간주하기까지 걸리는 시간. 특히
# UNVERIFIED_QUOTA_* 는 창이 없는 누적 한도라, 안 지우면 그 계정이
# 영영 잠긴다. 근거와 계산은 app/config.py의 reservation_ttl_seconds
# 주석 참조 — 값을 줄일수록 진행 중인 정상 요청까지 스윕될 위험이 커진다.
RESERVATION_TTL_SECONDS=600

# Postgres 자격증명. 공개 호스트에 올린다면 비밀번호를 반드시 바꿀 것 —
# compose 기본값은 로컬 편의용이고, 기본 비밀번호는 제일 먼저 시도된다.
# DB 포트는 127.0.0.1 에만 바인딩된다(앱은 compose 네트워크로 닿는다).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=docs_rag

# --- M7 W2: MCP 서버 ---
# 기존 FastAPI 앱에 마운트된다(별도 프로세스 아님). 끄면 경로가 404 다.
MCP_ENABLED=true
MCP_PATH=/mcp
# DNS 리바인딩 보호. **비워 두면 로컬호스트만 허용한다** — 공개 도메인으로
# 붙이려면 여기에 그 도메인을 넣어야 하고, 안 넣으면 421 Invalid Host header
# 가 난다. 기본을 "전부 허용"이 아니라 이쪽으로 둔 것은 의도다: 잊었을 때
# 조용히 열려 있는 것보다 시끄럽게 실패하는 쪽이 낫다(SESSION_COOKIE_SECURE
# 와 같은 판단). JSON 배열로 적는다.
# MCP_ALLOWED_HOSTS=["docs.example.com"]
# Claude·Cursor 는 브라우저가 아니라 Origin 을 보내지 않는다 — 브라우저에서
# 직접 붙일 때만 채운다.
# MCP_ALLOWED_ORIGINS=["https://docs.example.com"]
# tools/list 응답에 실리는 ttlMs. 툴 목록은 배포 때만 바뀐다.
MCP_TOOLS_CACHE_TTL_MS=60000
# RFC 9728 보호 자원 메타데이터. 비우면 끈다 — W7 에서 켤 때 이 값만 채우면
# 되도록 설정으로 빼 두었다.
MCP_RESOURCE_SERVER_URL=

# --- M7 W7: OAuth 리소스 서버 ---
# 이 서버는 **토큰을 발급하지 않는다.** 로그인·동의·발급은 기존 IdP 의 일이고,
# 인가 서버를 직접 만드는 것은 M7 W7 이 명시적으로 범위 밖에 둔 일이다.
#
#   session  세션 행 베어러만 받는다 (Authorization: Bearer <session_id>).
#            **기본값이자, 지금 실제로 동작하는 유일한 경로다.**
#   oauth    아래 IdP 가 발급한 JWT 만 받는다. 세션 베어러는 거절된다.
#   both     JWT 를 먼저 시도하고 아니면 세션으로 해석한다. 이행 구간용.
#
# oauth/both 로 두고 아래 값이 하나라도 비어 있으면 **앱이 기동하지 않는다.**
# 검증할 수 없는 채로 요청을 받는 상태가 생기지 않게 하려는 것이다.
# RFC 9728 메타데이터(/.well-known/oauth-protected-resource/...)와 401 의
# WWW-Authenticate resource_metadata= 도 이 값에 매달려 있다 — session 모드는
# 가리킬 인가 서버가 없으므로 켜지 않는다.
MCP_AUTH_MODE=session
# iss 클레임과 **정확히 같은 문자열**이어야 한다. 끝의 / 하나가 검증을 깨뜨린다.
# MCP_OAUTH_ISSUER=https://idp.example.com/
# 서명 키를 가져올 JWKS 문서. 로컬 검증이라 요청마다 IdP 를 때리지 않는다.
# MCP_OAUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# aud 클레임이 이 값과 같아야 한다 = "우리 서버용으로 발급된 토큰인가".
# 비우면 MCP_RESOURCE_SERVER_URL 을 쓴다(RFC 8707 에서 둘은 같은 것이다).
# MCP_OAUTH_AUDIENCE=
# 허용 서명 알고리즘. 목록으로 못박는 것이 요점이다 — 토큰의 alg 헤더를 그대로
# 믿으면 alg=none 과 HS256 혼동 공격이 열린다. JSON 배열로 적는다.
# MCP_OAUTH_ALGORITHMS=["RS256"]

# --- M7 W7: 관측성 ---
# 기본이 false 이고, false 는 "싸다"가 아니라 no-op 이다 — TracerProvider 를
# 아예 설치하지 않으므로 스팬이 만들어지지 않는다. 수집기 없이 clone 해도
# 앱은 그대로 동작한다.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=docs-rag
# console | otlp. otlp 는 opentelemetry-exporter-otlp-proto-http 를 따로
# 설치해야 하고, 없으면 기동 시 에러 로그를 남기고 계측 없이 계속 간다.
OTEL_EXPORTER=console

# --- M7 W6: L2 judge (로컬 생성 모델) ---
# 평가 전용이다. 애플리케이션 경로는 이 값들을 하나도 읽지 않는다 —
# eval/judge_local.py 만 읽는다. judge 가 로컬인 이유는 두 가지가 겹쳐서다:
# W6 은 피평가 모델과 다른 계열을 쓰라고 하고(생성은 Gemini), M7 은 "judge용
# 외부 LLM 에 문서 청크를 넣어도 되는지"를 아직 못 정했다. 로컬 judge 는
# 앞을 만족하면서 뒤를 없앤다 — 청크가 이 맥을 떠나지 않는다.
#
#   ollama pull qwen3:4b     # 2.5GB, 한 번
#
JUDGE_PROVIDER=ollama
JUDGE_BASE_URL=http://127.0.0.1:11434
# Qwen 계열. gemma3 는 Gemini 와 같은 구글 계보라 쓰지 않는다 — W6 이 피하라고
# 한 자기채점에 가장 가까운 선택이 된다.
JUDGE_MODEL=qwen3:4b
JUDGE_TIMEOUT_S=180
# 루브릭 전문 + 컨텍스트가 들어간다. 넘치면 앞이 잘리는데, 잘려 나가는 것이
# 하필 루브릭이다.
JUDGE_NUM_CTX=8192
JUDGE_KEEP_ALIVE=5m
